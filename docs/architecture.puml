@startuml M8 System Architecture

skinparam backgroundColor #1a1a2e
skinparam defaultFontColor #e0e0e0
skinparam defaultFontName Monospaced
skinparam componentBackgroundColor #16213e
skinparam componentBorderColor #0f3460
skinparam packageBackgroundColor #1a1a2e
skinparam packageBorderColor #533483
skinparam arrowColor #e94560
skinparam noteBackgroundColor #0f3460

title M8 Tracker — System Architecture

package "Android App" {
    package "Kotlin Layer" {
        [MainActivity] as MA
        [M8ViewModel] as VM
        [M8Emulator] as EMU
        [M8Song / Sequencer] as SEQ
        [Compose UI] as UI
    }

    package "Native Layer (Rust)" {
        [libm8_synth.so] as SYNTH
        note right of SYNTH
            PolyBLEP oscillators
            2-pole SVF filter
            ADSR envelopes
            Delay + Reverb
            Soft limiter
        end note
    }

    package "Audio Output" {
        [AudioTrack] as AT
    }
}

MA --> VM : viewModels()
VM --> EMU : renderFrame()
VM --> SEQ : advanceSequencer()
VM --> SYNTH : triggerRow() / generateChunk()\n<b>JNI calls</b>
VM --> AT : write(pcm)\n<b>blocks = backpressure</b>
EMU --> UI : SLIP display commands
UI --> MA : touch/key input

@enduml

@startuml M8 Audio Pipeline

skinparam backgroundColor #1a1a2e
skinparam defaultFontColor #e0e0e0
skinparam activityBackgroundColor #16213e
skinparam activityBorderColor #0f3460

title M8 Audio Pipeline (per chunk = 735 samples)

start
:Sequencer checks timing;
if (samplesUntilNextRow <= 0?) then (yes)
    :triggerRow(notes, vols);
    note right: JNI → Rust
    :advanceSequencer();
endif

:generateChunk();
note right
    Rust native code:
    for each sample {
        for each voice {
            oscillator (PolyBLEP)
            SVF filter
            ADSR envelope
        }
        mix + pan
        delay effect
        reverb effect
        soft limiter
        → 16-bit PCM
    }
end note

:AudioTrack.write(pcm);
note right: **Blocks** when buffer full\n= natural real-time pacing

stop

@enduml

@startuml M8 Voice Signal Flow

skinparam backgroundColor #1a1a2e
skinparam defaultFontColor #e0e0e0

title M8 Voice Signal Flow (Rust)

rectangle "Oscillator" as OSC {
    card "Saw (PolyBLEP)" as SAW
    card "Pulse (PolyBLEP)" as PUL
    card "Sine" as SIN
    card "Triangle" as TRI
    card "Noise (LFSR)" as NOI
    card "FM (2-op)" as FM
}

rectangle "Filter" as FLT {
    card "2-pole SVF\n(stability clamped)" as SVF
}

rectangle "Envelope" as ENV {
    card "ADSR\n(exponential)" as ADSR
}

rectangle "Output" as OUT {
    card "Pan → Stereo" as PAN
    card "Send → Delay" as DL
    card "Send → Reverb" as RV
}

OSC --> SVF
SVF --> ADSR : filtered
ADSR --> PAN : enveloped × volume
PAN --> DL
PAN --> RV

@enduml
